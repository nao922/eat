<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ルート周辺の徒歩圏飲食店マップ</title>
  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      font-family: sans-serif;
    }
    #container {
      display: flex;
      height: 100vh;
    }
    #sidebar {
      width: 320px;
      padding: 20px;
      background: #f8f9fa;
      box-shadow: 2px 0 5px rgba(0,0,0,0.1);
      z-index: 10;
      overflow-y: auto;
    }
    #map {
      flex: 1;
      height: 100%;
    }
    .form-group {
      margin-bottom: 15px;
    }
    label {
      display: block;
      font-weight: bold;
      margin-bottom: 5px;
    }
    input, select, button {
      width: 100%;
      padding: 8px;
      box-sizing: border-box;
      border: 1px solid #ccc;
      border-radius: 4px;
    }
    button {
      background-color: #007bff;
      color: white;
      font-weight: bold;
      cursor: pointer;
      border: none;
      margin-top: 10px;
    }
    button:hover {
      background-color: #0056b3;
    }
    #status {
      margin-top: 10px;
      font-size: 0.9em;
      color: #666;
    }
  </style>

  <!-- Turf.js (空間計算・ポリゴン結合ライブラリ) -->
  <script src="https://cdn.jsdelivr.net/npm/@turf/turf@6/turf.min.js"></script>
</head>
<body>

<div id="container">
  <div id="sidebar">
    <h2>ルート周辺グルメ検索</h2>
    
    <div class="form-group">
      <label for="origin">出発地</label>
      <input type="text" id="origin" value="東京駅">
    </div>
    
    <div class="form-group">
      <label for="destination">目的地</label>
      <input type="text" id="destination" value="銀座駅">
    </div>
    
    <div class="form-group">
      <label for="walkMinutes">ルートからの許容徒歩圏</label>
      <select id="walkMinutes">
        <option value="5">徒歩 5分以内</option>
        <option value="10" selected>徒歩 10分以内</option>
        <option value="15">徒歩 15分以内</option>
        <option value="30">徒歩 30分以内</option>
      </select>
    </div>

    <div class="form-group">
      <label for="minRating">Google ☆評価フィルタ</label>
      <select id="minRating">
        <option value="0">指定なし</option>
        <option value="3.5">☆ 3.5 以上</option>
        <option value="4.0" selected>☆ 4.0 以上</option>
        <option value="4.5">☆ 4.5 以上</option>
      </select>
    </div>

    <button onclick="searchRouteAndPlaces()">検索実行</button>

    <div id="status"></div>
  </div>

  <div id="map"></div>
</div>

<script>
  // APIキーの設定（必ずご自身のキーに変更してください）
  const GOOGLE_MAPS_API_KEY = "YOUR_GOOGLE_MAPS_API_KEY";
  const MAPBOX_ACCESS_TOKEN = "YOUR_MAPBOX_ACCESS_TOKEN";

  let map;
  let directionsService;
  let directionsRenderer;
  let placesService;
  let markers = [];
  let isochronePolygonLayer;

  // Google Maps 初期化 callback
  function initMap() {
    map = new google.maps.Map(document.getElementById("map"), {
      center: { lat: 35.681236, lng: 139.767125 }, // 初期表示: 東京駅
      zoom: 14,
    });

    directionsService = new google.maps.DirectionsService();
    directionsRenderer = new google.maps.DirectionsRenderer({ map: map });
    placesService = new google.maps.places.PlacesService(map);
  }

  // メイン検索処理
  async function searchRouteAndPlaces() {
    const origin = document.getElementById("origin").value;
    const destination = document.getElementById("destination").value;
    const walkMinutes = parseInt(document.getElementById("walkMinutes").value);
    const minRating = parseFloat(document.getElementById("minRating").value);
    const statusDiv = document.getElementById("status");

    clearMap();
    statusDiv.innerText = "ルートを取得中...";

    // 1. Google Directions API でルート取得
    directionsService.route(
      {
        origin: origin,
        destination: destination,
        travelMode: google.maps.TravelMode.WALKING,
      },
      async (response, status) => {
        if (status !== "OK") {
          statusDiv.innerText = "ルートの検索に失敗しました: " + status;
          return;
        }

        directionsRenderer.setDirections(response);
        const routePath = response.routes[0].overview_path;

        // 2. APIの過剰呼出を防ぐためルート上のチェックポイントをサンプリング（約5点）
        const sampledPoints = sampleRoutePoints(routePath, 5);

        statusDiv.innerText = "Mapboxから徒歩到達圏（Isochrone）を取得中...";

        try {
          // 3. 手法B: Mapbox Isochrone API を呼び出し、Turf.jsでポリゴンを結合
          const mergedIsochrone = await fetchAndMergeIsochrones(sampledPoints, walkMinutes);

          // 地図上に到達可能エリア（赤色の半透明ポリゴン）を描画
          drawPolygonOnMap(mergedIsochrone);

          statusDiv.innerText = "周辺の飲食店を取得して判定中...";

          // 4. 周辺の飲食店を取得し「Mapboxの徒歩圏内」かつ「Google評価」を満たすか判定
          const rawPlaces = await fetchNearbyRestaurants(routePath);
          
          const filteredPlaces = rawPlaces.filter(place => {
            if (!place.geometry || !place.geometry.location) return false;
            
            // Google ☆評価フィルタ
            if (minRating > 0 && (!place.rating || place.rating < minRating)) {
              return false;
            }

            // 到達圏（Isochroneポリゴン）内判定
            const pt = turf.point([place.geometry.location.lng(), place.geometry.location.lat()]);
            return turf.booleanPointInPolygon(pt, mergedIsochrone);
          });

          // 5. 条件に合った店舗にピンを立てる
          displayMarkers(filteredPlaces);
          statusDiv.innerText = `完了: 条件に該当する飲食店が ${filteredPlaces.length} 件見つかりました。`;

        } catch (err) {
          console.error(err);
          statusDiv.innerText = "エラーが発生しました: " + err.message;
        }
      }
    );
  }

  // ルートからいくつかの点を抽出する関数
  function sampleRoutePoints(path, maxPoints) {
    const points = [];
    const step = Math.max(1, Math.floor(path.length / maxPoints));
    for (let i = 0; i < path.length; i += step) {
      points.push(path[i]);
    }
    if (points[points.length - 1] !== path[path.length - 1]) {
      points.push(path[path.length - 1]);
    }
    return points;
  }

  // 手法B: Mapbox Isochrone API から到達圏を取得しTurf.jsで合体
  async function fetchAndMergeIsochrones(points, minutes) {
    let combinedPolygon = null;

    for (const pt of points) {
      const lng = pt.lng();
      const lat = pt.lat();
      // Mapbox Isochrone API (Profile: walking)
      const url = `https://api.mapbox.com/isochrone/v1/mapbox/walking/${lng},${lat}?contours_minutes=${minutes}&polygons=true&access_token=${MAPBOX_ACCESS_TOKEN}`;

      const res = await fetch(url);
      const data = await res.json();

      if (data.features && data.features.length > 0) {
        const poly = data.features[0];
        if (!combinedPolygon) {
          combinedPolygon = poly;
        } else {
          // Turf.js の union で複数のポリゴン領域をひとつに合体
          combinedPolygon = turf.union(combinedPolygon, poly);
        }
      }
    }
    return combinedPolygon;
  }

  // Google Places API でルート付近の飲食店を取得
  function fetchNearbyRestaurants(routePath) {
    return new Promise((resolve) => {
      const midPoint = routePath[Math.floor(routePath.length / 2)];

      const request = {
        location: midPoint,
        radius: 2000, // 大きめの半径で検索して後からIsochroneで正確に絞り込む
        type: ['restaurant']
      };

      placesService.nearbySearch(request, (results, status) => {
        if (status === google.maps.places.PlacesServiceStatus.OK && results) {
          resolve(results);
        } else {
          resolve([]);
        }
      });
    });
  }

  // Map上へ Isochrone ポリゴンの描画
  function drawPolygonOnMap(geoJsonPolygon) {
    if (isochronePolygonLayer) {
      isochronePolygonLayer.setMap(null);
    }

    const coordinates = geoJsonPolygon.geometry.coordinates[0].map(coord => ({
      lat: coord[1],
      lng: coord[0]
    }));

    isochronePolygonLayer = new google.maps.Polygon({
      paths: coordinates,
      strokeColor: "#FF0000",
      strokeOpacity: 0.8,
      strokeWeight: 2,
      fillColor: "#FF0000",
      fillOpacity: 0.15,
      map: map
    });
  }

  // マーカー（ピン）の表示
  function displayMarkers(places) {
    const infoWindow = new google.maps.InfoWindow();

    places.forEach((place) => {
      const marker = new google.maps.Marker({
        position: place.geometry.location,
        map: map,
        title: place.name,
        icon: {
          url: "http://maps.google.com/mapfiles/ms/icons/restaurant.png"
        }
      });

      marker.addListener("click", () => {
        const content = `
          <div style="padding:5px;">
            <strong>${place.name}</strong><br>
            評価: ⭐ ${place.rating || "なし"} (${place.user_ratings_total || 0}件)<br>
            住所: ${place.vicinity || ""}
          </div>
        `;
        infoWindow.setContent(content);
        infoWindow.open(map, marker);
      });

      markers.push(marker);
    });
  }

  // 地図のクリア
  function clearMap() {
    markers.forEach(m => m.setMap(null));
    markers = [];
    if (isochronePolygonLayer) {
      isochronePolygonLayer.setMap(null);
    }
  }
</script>

<!-- Google Maps JavaScript API (Places ライブラリ有効化) -->
<script src="https://maps.googleapis.com/maps/api/js?key=YOUR_GOOGLE_MAPS_API_KEY&libraries=places&callback=initMap" async defer></script>

</body>
</html>
